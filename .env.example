# If unset, deepagents defaults are used. Set this to force a model.
# Available models:
#   nvidia:nemotron-3-super-120b-a12b (default)
#   nvidia:nemotron-3-ultra-550b-a55b
#   anthropic:claude-sonnet-4-6
#   openai:gpt-4o
DEEP_AGENT_MODEL=nvidia:nemotron-3-super-120b-a12b

# Required for NVIDIA models (get key at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key

# Required if using Anthropic models
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional but recommended for tracing.
LANGSMITH_API_KEY=lsv2_...
